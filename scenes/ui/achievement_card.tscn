[ext_resource type="Script" path="res://scripts/ui/achievement_card.gd" id="1_card"]
[ext_resource type="Texture2D" path="res://assets/ui/uis/achiev_card.png" id="2_card_background"]

[sub_resource type="Shader" id="Shader_icon_saturation"]
code = "shader_type canvas_item;\n\nuniform float saturation : hint_range(0.0, 1.0) = 1.0;\n\nvoid fragment() {\n\tvec4 color = texture(TEXTURE, UV) * COLOR;\n\tfloat gray = dot(color.rgb, vec3(0.299, 0.587, 0.114));\n\tcolor.rgb = mix(vec3(gray), color.rgb, saturation);\n\tCOLOR = color;\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_icon_saturation"]
resource_local_to_scene = true
shader = SubResource("Shader_icon_saturation")
shader_parameter/saturation = 1.0

